      "source": [
        "# **19. Midtown West Low-Record Check**"
      ],
      "metadata": {
        "id": "H1ABgMThuKM5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "location_counts = working_df.groupby(\"Location\").size().sort_values()\n",
        "\n",
        "print(\"Record count by location:\")\n",
        "display(location_counts.reset_index(name=\"Record_Count\"))\n",
        "\n",
        "print(\"Low-record locations:\")\n",
        "display(location_counts[location_counts < 100].reset_index(name=\"Record_Count\"))\n"
      ],
