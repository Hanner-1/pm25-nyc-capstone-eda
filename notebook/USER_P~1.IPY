    {
      "cell_type": "markdown",
      "source": [
        "# **17. Short-Term Spike Flag**"
      ],
      "metadata": {
        "id": "_3M7Lv_GtDct"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "This is a lightweight clinical attention marker, not a legal compliance threshold."
      ],
      "metadata": {
        "id": "7xsjrZ5jtXWa"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "SPIKE_ATTENTION_LEVEL = 10\n",
        "\n",
        "working_df[\"At_Or_Above_10\"] = working_df[\"Value_Imputed\"] >= SPIKE_ATTENTION_LEVEL\n",
        "\n",
        "print(\"Hourly records at or above 10 µg/m³:\")\n",
        "print(working_df[\"At_Or_Above_10\"].sum())\n",
        "\n",
        "display(\n",
        "    working_df[working_df[\"At_Or_Above_10\"]]\n",
        "    [[\"ID\", \"Location\", \"ObservationTimeUTC\", \"Value_Imputed\"]]\n",
        "    .sort_values(\"Value_Imputed\", ascending=False)\n",
        "    .head(20)\n",
        ")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 712
        },
        "id": "vKV1MVYDtYTd",
        "outputId": "f8fdb0b0-ea49-48ff-84c7-c69c9726e4d1"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Hourly records at or above 10 µg/m³:\n",
            "841\n"
          ]
        },
        {
          "output_type": "display_data",
