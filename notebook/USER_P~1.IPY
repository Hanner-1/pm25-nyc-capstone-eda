    {
      "cell_type": "markdown",
      "source": [
        "## **15B. Bivariate Boxplot: PM2.5 by Location**"
      ],
      "metadata": {
        "id": "KnbNOtr90uOI"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 15B. Bivariate Boxplot: PM2.5 Distribution by Location\n",
        "\n",
        "# Prepare data grouped by location\n",
        "locations_sorted = (\n",
        "    working_df.groupby(\"Location\")[\"Value_Imputed\"]\n",
        "    .median()\n",
        "    .sort_values(ascending=False)\n",
        "    .index\n",
        ")\n",
        "\n",
        "boxplot_data = [\n",
        "    working_df.loc[working_df[\"Location\"] == location, \"Value_Imputed\"].dropna()\n",
        "    for location in locations_sorted\n",
        "]\n",
        "\n",
        "plt.figure(figsize=(12, 7))\n",
        "plt.boxplot(boxplot_data, labels=locations_sorted, vert=False)\n",
        "plt.title(\"Boxplot of PM2.5 Values by Monitoring Location\")\n",
        "plt.xlabel(\"PM2.5 (µg/m³)\")\n",
        "plt.ylabel(\"Monitoring Location\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 763
        },
        "id": "Sp6ARj430t3S",
        "outputId": "49ad523b-59fc-44e1-cd95-93ddebd31f92"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "/tmp/ipykernel_5420/3621757567.py:17: MatplotlibDeprecationWarning: The 'labels' parameter of boxplot() has been renamed 'tick_labels' since Matplotlib 3.9; support for the old name will be dropped in 3.11.\n",
            "  plt.boxplot(boxplot_data, labels=locations_sorted, vert=False)\n"
          ]
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1200x700 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# **16. Threshold Analysis: 24-Hour Standard**"
      ],
      "metadata": {
        "id": "_L0xIs1TrM0E"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "The 24-hour standard used here is 35 µg/m³.\n",
        "\n"
      ],
      "metadata": {
        "id": "Da5qsz_WrX6c"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "STANDARD_24H = 35\n",
        "\n",
        "# Daily average by location.\n",
        "daily_location_avg = (\n",
        "    working_df.groupby([\"Date\", \"Location\"])[\"Value_Imputed\"]\n",
        "    .mean()\n",
        "    .reset_index(name=\"Daily_Location_Avg_PM25\")\n",
        ")\n",
        "\n",
        "daily_location_avg[\"Above_35\"] = daily_location_avg[\"Daily_Location_Avg_PM25\"] > STANDARD_24H\n",
        "\n",
        "print(\"Number of daily location averages above 35 µg/m³:\")\n",
        "print(daily_location_avg[\"Above_35\"].sum())\n",
        "\n",
        "display(\n",
        "    daily_location_avg.sort_values(\"Daily_Location_Avg_PM25\", ascending=False).head(10)\n",
        ")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
