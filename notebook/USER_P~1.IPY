    {
      "cell_type": "markdown",
      "source": [
        "# **10. Imputation**"
      ],
      "metadata": {
        "id": "qa-SQRxCjZ5W"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "I use median imputation by station/location because PM2.5 values may vary by monitor location and the median is less sensitive to spikes than the mean.\n"
      ],
      "metadata": {
        "id": "GPHEiCJKjcnk"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Preserve original Value column before imputation.\n",
        "working_df[\"Value_Original_With_Missing\"] = working_df[\"Value\"]\n",
        "\n",
        "# Station-level median imputation.\n",
        "working_df[\"Value_Imputed\"] = working_df.groupby(\"Location\")[\"Value\"].transform(\n",
        "    lambda x: x.fillna(x.median())\n",
        ")\n",
        "\n",
        "# Fallback in case any station has all missing values.\n",
        "overall_median = working_df[\"Value\"].median()\n",
        "working_df[\"Value_Imputed\"] = working_df[\"Value_Imputed\"].fillna(overall_median)\n",
        "\n",
        "print(\"Missing Value before imputation:\", working_df[\"Value\"].isna().sum())\n",
        "print(\"Missing Value_Imputed after imputation:\", working_df[\"Value_Imputed\"].isna().sum())\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "BIIn9CAOjpI2",
        "outputId": "581e3193-45b9-4801-d935-cb8328bc0ecd"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Missing Value before imputation: 109\n",
            "Missing Value_Imputed after imputation: 0\n"
          ]
        }
      ]
    },
