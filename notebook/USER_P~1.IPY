    {
      "cell_type": "markdown",
      "source": [
        "## **13B. Univariate Boxplot: Overall PM2.5 Distribution**"
      ],
      "metadata": {
        "id": "W55HbUa00eTw"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 13B. Univariate Boxplot: Overall PM2.5 Distribution\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.boxplot(working_df[\"Value_Imputed\"].dropna(), vert=False)\n",
        "plt.title(\"Boxplot of PM2.5 Values After Imputation\")\n",
        "plt.xlabel(\"PM2.5 (µg/m³)\")\n",
        "plt.show()\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 487
        },
        "id": "VlzvyCLF0g_8",
