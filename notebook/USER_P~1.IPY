        "    \"Hour\",\n",
        "    \"Day\",\n",
        "    \"Latitude\",\n",
        "    \"Longitude\"\n",
        "]].copy()\n",
        "\n",
        "correlation_matrix = corr_df.corr(numeric_only=True)\n",
        "\n",
        "print(\"Correlation matrix:\")\n",
        "display(correlation_matrix)\n"
      ],
