    {
      "cell_type": "markdown",
      "source": [
        "# **12. Univariate Analysis 1: PM2.5 Distribution**"
      ],
      "metadata": {
        "id": "qRmG2YT5lrf-"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "plt.figure(figsize=(10, 6))\n",
        "plt.hist(working_df[\"Value_Imputed\"], bins=30)\n",
        "plt.title(\"Distribution of PM2.5 Values After Imputation\")\n",
        "plt.xlabel(\"PM2.5 (µg/m³)\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "plt.show()\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 564
        },
        "id": "pj2UfcuPlyME",
        "outputId": "4781e87a-0373-4f3c-893f-c65403eb8579"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1000x600 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# **13. Univariate Analysis 2: PM2.5 by Hour of Day**"
      ],
      "metadata": {
        "id": "TYbHYqkgpULN"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "hourly_avg = working_df.groupby(\"Hour\")[\"Value_Imputed\"].mean()\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(hourly_avg.index, hourly_avg.values, marker=\"o\")\n",
        "plt.title(\"Average PM2.5 by Hour of Day\")\n",
        "plt.xlabel(\"Hour of Day\")\n",
        "plt.ylabel(\"Average PM2.5 (µg/m³)\")\n",
        "plt.xticks(range(0, 24))\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "display(hourly_avg.reset_index(name=\"Average_PM25\"))\n"
      ],
