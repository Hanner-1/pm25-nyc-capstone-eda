    },
    {
      "cell_type": "markdown",
      "source": [
        "# **6. Create Active Capstone Working Dataset**"
      ],
      "metadata": {
        "id": "c03R6GtJdc2C"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "This step uses the original clean dataset as the timestamp-safe source, then applies the missing-value pattern from the capstone reference file."
      ],
      "metadata": {
        "id": "bAxA0hZMdfN3"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Copy the clean timestamp-safe source dataframe.\n",
        "working_df = source_df.copy()\n",
        "\n",
        "# Make sure ID fields align.\n",
        "working_df[\"ID\"] = working_df[\"ID\"].astype(str)\n",
        "capstone_missing_ref_df[\"ID\"] = capstone_missing_ref_df[\"ID\"].astype(str)\n",
        "\n",
        "# Identify which IDs have missing Value in the capstone reference dataset.\n",
        "missing_value_ids = capstone_missing_ref_df.loc[\n",
        "    capstone_missing_ref_df[\"Value\"].isna(), \"ID\"\n",
        "]\n",
        "\n",
        "print(\"Number of controlled missing Value records:\", len(missing_value_ids))\n",
        "\n",
        "# Apply the same missing pattern to the working dataframe.\n",
        "working_df.loc[working_df[\"ID\"].isin(missing_value_ids), \"Value\"] = np.nan\n",
        "\n",
        "print(\"Active working dataset created.\")\n",
        "print(\"Rows:\", working_df.shape[0])\n",
        "print(\"Columns:\", working_df.shape[1])\n",
        "print(\"Missing Value count:\", working_df[\"Value\"].isna().sum())\n",
        "print(\"Missing Value percentage:\", round(working_df[\"Value\"].isna().mean() * 100, 2), \"%\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "sb_lK0mvdhjL",
        "outputId": "13436e9f-e291-414f-b897-25e0b7f73add"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Number of controlled missing Value records: 109\n",
            "Active working dataset created.\n",
            "Rows: 5608\n",
            "Columns: 4\n",
            "Missing Value count: 109\n",
            "Missing Value percentage: 1.94 %\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## **6B. Create Date, Hour, and Day columns**"
      ],
      "metadata": {
        "id": "5JwKlllAnf9t"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Create time fields for later EDA\n",
        "\n",
        "working_df[\"ObservationTimeUTC\"] = pd.to_datetime(\n",
        "    working_df[\"ObservationTimeUTC\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "working_df[\"Date\"] = working_df[\"ObservationTimeUTC\"].dt.date\n",
        "working_df[\"Hour\"] = working_df[\"ObservationTimeUTC\"].dt.hour\n",
        "working_df[\"Day\"] = working_df[\"ObservationTimeUTC\"].dt.day\n",
        "\n",
        "display(working_df[[\"ObservationTimeUTC\", \"Date\", \"Hour\", \"Day\"]].head())\n"
